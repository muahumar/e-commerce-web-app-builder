PORT=5000
MONGO_URI=mongodb://localhost:27017/ecom_builder
JWT_SECRET=change-me
JWT_EXPIRES_IN=7d
BCRYPT_ROUNDS=10
# Required once to create the very first Super Admin via POST /api/superadmin/auth/register
SUPERADMIN_BOOTSTRAP_SECRET=change-me-too
FRONTEND_ORIGIN=http://localhost:3000
# Host suffix used for subdomain tenant resolution, e.g. clientname.platform.com
PLATFORM_DOMAIN=platform.com
# Optional Stripe test secret key (falls back to built-in test-mode simulator if omitted)
STRIPE_SECRET_KEY=sk_test_...
